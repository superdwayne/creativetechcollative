{
  "framework": "vite",
  "devCommand": "vite --port $PORT --host",
  "functions": {
    "api/admin/[[...path]].ts": {
      "maxDuration": 120
    },
    "api/messages/[[...path]].ts": {
      "maxDuration": 30
    },
    "api/beta/[[...path]].ts": {
      "maxDuration": 30
    },
    "api/jobs/[[...path]].ts": {
      "maxDuration": 60
    },
    "api/company/talent-agent.ts": {
      "maxDuration": 120
    },
    "api/company/[[...path]].ts": {
      "maxDuration": 30
    },
    "api/profiles/[[...path]].ts": {
      "maxDuration": 60
    },
    "api/match-job.ts": {
      "maxDuration": 120
    },
    "api/generate-embeddings.ts": {
      "maxDuration": 300
    },
    "api/enrich-profiles.ts": {
      "maxDuration": 300
    },
    "api/enrich-profile-search.ts": {
      "maxDuration": 120
    },
    "api/webhooks/stripe.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/admin/(.*)", "dest": "/api/admin/[[...path]]" },
    { "src": "/api/admin", "dest": "/api/admin/[[...path]]" },
    { "src": "/api/beta/(.*)", "dest": "/api/beta/[[...path]]" },
    { "src": "/api/beta", "dest": "/api/beta/[[...path]]" },
    { "src": "/api/messages/(.*)", "dest": "/api/messages/[[...path]]" },
    { "src": "/api/messages", "dest": "/api/messages/[[...path]]" },
    { "src": "/api/jobs/(.*)", "dest": "/api/jobs/[[...path]]" },
    { "src": "/api/jobs", "dest": "/api/jobs/[[...path]]" },
    { "src": "/api/company/ct-finder", "dest": "/api/company/talent-agent" },
    { "src": "/api/company/talent-agent", "dest": "/api/company/talent-agent" },
    { "src": "/api/company/(.*)", "dest": "/api/company/[[...path]]" },
    { "src": "/api/company", "dest": "/api/company/[[...path]]" },
    { "src": "/api/profiles/(.*)", "dest": "/api/profiles/[[...path]]" },
    { "src": "/api/profiles", "dest": "/api/profiles/[[...path]]" },
    { "handle": "filesystem" },
    { "src": "/((?!api/).*)", "dest": "/index.html" }
  ]
}
