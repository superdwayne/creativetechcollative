# n8n Webhook Authentication
VITE_N8N_BASIC_AUTH_USERNAME=your_username
VITE_N8N_BASIC_AUTH_PASSWORD=your_password

# Test mode (set to TRUE for test webhooks)
VITE_TEST=FALSE

# Supabase Configuration (for CTC Network profiles)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (for server-side operations that bypass RLS)
# Used by API endpoints for admin operations and matching engine
# Get this from Supabase Dashboard > Settings > API > service_role key
# WARNING: Never expose this key in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===== AI Job Matching Engine =====

# OpenAI API Key (for generating vector embeddings)
# Used by: profile enrichment, job matching
# Model: text-embedding-3-small (1536 dimensions)
# Rate limits: 3,000 RPM, 1,000,000 TPM on free tier
# Pricing: ~$0.02 per 1M tokens
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key (for Claude AI match ranking)
# Used by: job matching engine to analyze and rank candidates
# Model: claude-sonnet-4-20250514 (cost-effective for analysis)
# Rate limits: 60 RPM, 100,000 TPM on free tier
# Pricing: ~$3/$15 per 1M tokens (input/output)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Admin User IDs (comma-separated UUIDs for admin access)
# Users with these IDs can:
# - Trigger batch profile enrichment
# - Run job matching for any company
# - Review and approve/reject matches
# - Access admin endpoints (jobs list, matches list)
# Get user IDs from Supabase Dashboard > Authentication > Users
ADMIN_USER_IDS=uuid1,uuid2,uuid3
